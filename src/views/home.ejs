<!DOCTYPE html>
<html lang="en">

<head>

    <meta name="keywords"
        content="Jabiullah, Web Developer, Software Developer, B.Tech CSE, Portfolio, HTML, CSS, JavaScript, Python, Node.js, Express, EJS">

    <meta name="author" content="Jabiullah">

    <meta name="robots" content="index, follow">

    <meta property="og:title" content="Jabiullah | Web Developer Portfolio">

    <meta property="og:description"
        content="B.Tech CSE student and aspiring Web Developer building modern web projects.">

    <meta property="og:type" content="website">

    <meta property="og:url" content="https://jabiullah-portfolio.onrender.com">
    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css?v=2">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/profile.png">
</head>


<body>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="header">

        <div class="container nav-container">

            <a href="#home" class="logo">

                <img src="/images/profile.png" alt="Jabiullah">

            </a>


            <nav class="desktop-nav">

                <a href="#home">
                    Home
                </a>

                <a href="#about">
                    About
                </a>

                <a href="#skills">
                    Skills
                </a>

                <a href="#education">
                    Education
                </a>

                <a href="#projects">
                    Projects
                </a>

                <a href="#contact">
                    Contact
                </a>

            </nav>


            <button class="menu-btn" id="menuBtn" type="button">

                ☰

            </button>

        </div>


        <!-- MOBILE MENU -->

        <div class="mobile-menu" id="mobileMenu">

            <a href="#home">
                Home
            </a>

            <a href="#about">
                About
            </a>

            <a href="#skills">
                Skills
            </a>

            <a href="#education">
                Education
            </a>
            <a href="#achievements">Achievements</a>

            <a href="#projects">
                Projects
            </a>

            <a href="#contact">
                Contact
            </a>

        </div>

    </header>



    <!-- =====================================================
         HERO
    ====================================================== -->

    <main>

        <section class="hero" id="home">


            <div class="hero-bg"></div>


            <div class="container hero-container">


                <!-- HERO LEFT -->

                <div class="hero-content">


                    <p class="hero-small">

                        HELLO, I'M

                    </p>


                    <h1>

                        <%= portfolio.personal.name %>

                    </h1>


                    <h2>

                        <span id="typingText">

                            Web Developer

                        </span>

                    </h2>


                    <p class="hero-description">

                        <%= portfolio.personal.bio %>

                    </p>


                    <div class="hero-info">

                        <span>

                            📍

                            <%= portfolio.personal.location %>

                        </span>


                        <span>

                            🎓 B.Tech CSE

                        </span>

                    </div>


                    <div class="hero-buttons">


                        <a href="#projects" class="btn primary-btn">

                            View My Work

                        </a>


                        <a href="#contact" class="btn outline-btn">

                            Contact Me

                        </a>


                        <a href="/resume/Jabiullah_Resume.pdf" class="btn resume-btn" target="_blank"
                            rel="noopener noreferrer">

                            <i class="fa-solid fa-file-arrow-down"></i>

                            Download Resume

                        </a>

                    </div>



                    <!-- SOCIAL MEDIA ICONS -->

                    <div class="social-links">


                        <!-- Instagram -->

                        <a href="https://www.instagram.com/imjabi_305" target="_blank" rel="noopener noreferrer"
                            aria-label="Instagram">

                            <i class="fa-brands fa-instagram"></i>

                        </a>


                        <!-- LinkedIn -->

                        <a href="https://www.linkedin.com/in/zabi-basir-a0b832249" target="_blank"
                            rel="noopener noreferrer" aria-label="LinkedIn">

                            <i class="fa-brands fa-linkedin-in"></i>

                        </a>


                        <!-- Facebook -->

                        <a href="https://www.facebook.com/share/1BgF3H2wVy/" target="_blank" rel="noopener noreferrer"
                            aria-label="Facebook">

                            <i class="fa-brands fa-facebook-f"></i>

                        </a>


                        <!-- X -->

                        <a href="https://x.com/im_zabi_378" target="_blank" rel="noopener noreferrer" aria-label="X">

                            <i class="fa-brands fa-x-twitter"></i>

                        </a>


                    </div>

                </div>



                <!-- HERO RIGHT / PROFILE -->

                <div class="hero-profile">


                    <div class="profile-glow"></div>


                    <div class="profile-card">


                        <img src="/images/profile.png" alt="Jabiullah Profile Photo" class="profile-photo">


                        <div class="profile-name">

                            Jabiullah

                        </div>


                        <div class="profile-role">

                            CSE STUDENT

                        </div>


                    </div>

                </div>


            </div>



            <!-- SCROLL DOWN -->

            <div class="scroll-down">

                <span>

                    SCROLL DOWN

                </span>


                <div>

                    ↓

                </div>

            </div>


        </section>



        <!-- =====================================================
             ABOUT
        ====================================================== -->

        <section class="section about-section" id="about">

            <div class="container">


                <div class="section-heading">

                    <span>
                        01
                    </span>

                    <div>

                        <p>
                            GET TO KNOW ME
                        </p>

                        <h2>
                            About Me
                        </h2>

                    </div>

                </div>



                <div class="about-grid">


                    <div class="about-text">


                        <h3>

                            Passionate about

                            <span>
                                Technology
                            </span>

                        </h3>


                        <p>

                            I am

                            <strong>
                                <%= portfolio.personal.name %>
                            </strong>,

                            a Computer Science & Engineering
                            student passionate about coding,
                            web development and modern technology.

                        </p>


                        <p>

                            Currently I am studying B.Tech in
                            Computer Science & Engineering at

                            <strong>
                                <%= portfolio.education.college.name %>
                            </strong>.

                        </p>


                        <p>

                            I enjoy learning new technologies
                            and building real-world projects
                            that can solve practical problems.

                        </p>


                    </div>



                    <div class="about-card">


                        <div class="about-card-icon">

                            &lt;/&gt;

                        </div>


                        <h3>

                            My Focus

                        </h3>


                        <p>

                            Web Development

                            <br>

                            Software Development

                            <br>

                            Coding & Problem Solving

                        </p>


                    </div>


                </div>

            </div>

        </section>



        <!-- =====================================================
             SKILLS
        ====================================================== -->

        <!-- =====================================================
     SKILLS
====================================================== -->

        <section class="section skills-section" id="skills">

            <div class="container">

                <div class="section-heading">

                    <span>
                        02
                    </span>

                    <div>

                        <p>
                            WHAT I KNOW
                        </p>

                        <h2>
                            My Skills
                        </h2>

                    </div>

                </div>


                <div class="skills-grid">

                    <% portfolio.skills.forEach((skill, index)=> { %>

                        <div class="skill-card">

                            <div class="skill-number">

                                <%= String(index + 1).padStart(2, "0" ) %>

                            </div>


                            <div class="skill-content">

                                <div class="skill-title-row">

                                    <h3>
                                        <%= skill %>
                                    </h3>

                                    <span class="skill-percent">

                                        <% if (skill==="C Programming" ) { %>
                                            70%
                                            <% } else if (skill==="HTML" ) { %>
                                                90%
                                                <% } else if (skill==="CSS" ) { %>
                                                    85%
                                                    <% } else if (skill==="JavaScript" ) { %>
                                                        75%
                                                        <% } else if (skill==="Python" ) { %>
                                                            70%
                                                            <% } else if (skill==="Data Structures" ) { %>
                                                                60%
                                                                <% } else if (skill==="Java" ) { %>
                                                                    55%
                                                                    <% } else { %>
                                                                        50%
                                                                        <% } %>

                                    </span>

                                </div>


                                <div class="skill-progress">

                                    <div class="skill-progress-bar" data-skill="<%= skill %>">

                                    </div>

                                </div>


                                <p class="skill-level">

                                    <% if (skill==="HTML" ) { %>

                                        Frontend Foundation

                                        <% } else if (skill==="CSS" ) { %>

                                            UI & Styling

                                            <% } else if (skill==="JavaScript" ) { %>

                                                Web Development

                                                <% } else if (skill==="Python" ) { %>

                                                    Programming

                                                    <% } else if (skill==="C Programming" ) { %>

                                                        Programming Fundamentals

                                                        <% } else if (skill==="Data Structures" ) { %>

                                                            Problem Solving

                                                            <% } else if (skill==="Java" ) { %>

                                                                Currently Learning

                                                                <% } else { %>

                                                                    Learning

                                                                    <% } %>

                                </p>

                            </div>


                            <div class="skill-line"></div>

                        </div>

                        <% }) %>

                </div>


                <!-- Currently Learning -->

                <div class="learning-box">

                    <div>

                        <span>
                            CURRENTLY LEARNING
                        </span>

                        <h3>
                            Improving my skills every day 🚀
                        </h3>

                    </div>


                    <div class="learning-tags">

                        <% portfolio.learning.forEach((item)=> { %>

                            <span>

                                <i class="fa-solid fa-code"></i>

                                <%= item %>

                            </span>

                            <% }) %>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             EDUCATION
        ====================================================== -->

        <section class="section education-section" id="education">

            <div class="container">


                <div class="section-heading">

                    <span>
                        03
                    </span>

                    <div>

                        <p>
                            MY ACADEMIC JOURNEY
                        </p>

                        <h2>
                            Education
                        </h2>

                    </div>

                </div>



                <div class="timeline">


                    <!-- BTECH -->

                    <div class="timeline-item">

                        <div class="timeline-dot"></div>


                        <div class="timeline-content">


                            <span class="timeline-date">

                                2025 - 2029

                            </span>


                            <h3>

                                <%= portfolio.education.college.course %>

                            </h3>


                            <h4>

                                <%= portfolio.education.college.name %>

                            </h4>


                            <p>

                                Currently studying

                                <strong>

                                    <%= portfolio.education.college.year %>

                                </strong>

                                -

                                <%= portfolio.education.college.semester %>

                            </p>


                        </div>

                    </div>



                    <!-- 12TH -->

                    <div class="timeline-item">

                        <div class="timeline-dot"></div>


                        <div class="timeline-content">


                            <span class="timeline-date">

                                12th

                            </span>


                            <h3>

                                Higher Secondary

                            </h3>


                            <h4>

                                <%= portfolio.education.class12.school %>

                            </h4>


                            <p>

                                <%= portfolio.education.class12.board %>

                                    —

                                    <strong>

                                        <%= portfolio.education.class12.percentage %>

                                    </strong>

                            </p>


                        </div>

                    </div>



                    <!-- 10TH -->

                    <div class="timeline-item">

                        <div class="timeline-dot"></div>


                        <div class="timeline-content">


                            <span class="timeline-date">

                                10th

                            </span>


                            <h3>

                                Secondary School

                            </h3>


                            <h4>

                                <%= portfolio.education.class10.school %>

                            </h4>


                            <p>

                                <%= portfolio.education.class10.board %>

                                    —

                                    <strong>

                                        <%= portfolio.education.class10.percentage %>

                                    </strong>

                            </p>


                        </div>

                    </div>


                </div>

            </div>

        </section>
        <!-- =====================================================
     ACHIEVEMENTS & EXPERIENCE
===================================================== -->

        <section class="section achievements-section" id="achievements">

            <div class="container">

                <div class="section-heading">

                    <span>
                        04
                    </span>

                    <div>

                        <p>
                            MY EXPERIENCE
                        </p>

                        <h2>
                            Achievements & Experience
                        </h2>

                    </div>

                </div>


                <div class="achievements-grid">

                    <% portfolio.achievements.forEach((achievement, index)=> { %>

                        <div class="achievement-card">

                            <div class="achievement-top">

                                <div class="achievement-icon">

                                    <i class="fa-solid fa-award"></i>

                                </div>

                                <span class="achievement-number">

                                    <%= String(index + 1).padStart(2, "0" ) %>

                                </span>

                            </div>


                            <span class="achievement-status">

                                <i class="fa-solid fa-circle-check"></i>

                                <%= achievement.status %>

                            </span>


                            <h3>

                                <%= achievement.title %>

                            </h3>


                            <h4>

                                <%= achievement.organization %>

                            </h4>


                            <p>

                                <%= achievement.type %>

                            </p>


                            <div class="achievement-details">

                                <span>

                                    <i class="fa-regular fa-calendar"></i>

                                    Started:
                                    <%= achievement.startDate %>

                                </span>


                                <span>

                                    <i class="fa-solid fa-hashtag"></i>

                                    <%= achievement.referenceId %>

                                </span>

                            </div>
                            <a href="/certificate/Invigo_Internship_Acceptance_Letter.pdf" target="_blank"
                                rel="noopener noreferrer" class="achievement-certificate-btn">

                                <i class="fa-solid fa-file-pdf"></i>

                                View Acceptance Letter

                                <i class="fa-solid fa-arrow-up-right-from-square"></i>

                            </a>

                            <div class="achievement-line"></div>

                        </div>

                        <% }) %>

                </div>

            </div>

        </section>


        <!-- =====================================================
             PROJECTS
        ====================================================== -->

        <section class="section projects-section" id="projects">

            <div class="container">


                <div class="section-heading">

                    <span>
                        04
                    </span>

                    <div>

                        <p>
                            WHAT I'VE BUILT
                        </p>

                        <h2>
                            Projects
                        </h2>

                    </div>

                </div>



                <div class="projects-grid">


                    <% portfolio.projects.forEach((project, index)=> { %>


                        <article class="project-card">


                            <div class="project-top">


                                <span class="project-number">

                                    <%= String(index + 1).padStart(2, "0" ) %>

                                </span>


                                <span class="project-icon">

                                    <i class="fa-solid fa-code"></i>

                                </span>


                            </div>


                            <h3>

                                <%= project.name %>

                            </h3>


                            <p>

                                <%= project.description %>

                            </p>


                            <div class="project-tech">


                                <% project.technologies.forEach((tech)=> { %>


                                    <span>

                                        <%= tech %>

                                    </span>


                                    <% }) %>


                            </div>


                            <div class="project-buttons">


                                <a href="<%= project.github %>" target="_blank" rel="noopener noreferrer"
                                    class="project-btn github-btn">

                                    <i class="fa-brands fa-github"></i>

                                    GitHub

                                </a>


                                <a href="<%= project.live %>" target="_blank" rel="noopener noreferrer"
                                    class="project-btn live-btn">

                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>

                                    Live Demo

                                </a>


                            </div>


                        </article>


                        <% }) %>


                </div>

            </div>

        </section>



        <!-- =====================================================
             CAREER
        ====================================================== -->

        <section class="career-section">

            <div class="container">


                <div class="career-card">


                    <div>


                        <span class="career-label">

                            MY FUTURE GOAL

                        </span>


                        <h2>

                            Building.

                            Learning.

                            <span>
                                Growing.
                            </span>

                        </h2>


                        <p>

                            <%= portfolio.careerGoal %>

                        </p>


                    </div>


                    <div class="career-symbol">

                        &lt;/&gt;

                    </div>


                </div>

            </div>

        </section>



        <!-- =====================================================
             HOBBIES
        ====================================================== -->

        <section class="section hobbies-section">

            <div class="container">


                <div class="section-heading">

                    <span>
                        05
                    </span>

                    <div>

                        <p>
                            WHEN I'M NOT CODING
                        </p>

                        <h2>
                            My Hobbies
                        </h2>

                    </div>

                </div>



                <div class="hobbies-grid">


                    <% portfolio.hobbies.forEach((hobby)=> { %>


                        <div class="hobby-card">


                            <div class="hobby-icon">


                                <% if (hobby==="Coding" ) { %>

                                    &lt;/&gt;


                                    <% } else if (hobby==="Listening to Music" ) { %>

                                        ♪


                                        <% } else if (hobby==="Cricket" ) { %>

                                            🏏


                                            <% } %>


                            </div>


                            <h3>

                                <%= hobby %>

                            </h3>


                        </div>


                        <% }) %>


                </div>

            </div>

        </section>



        <!-- =====================================================
             CONTACT
        ====================================================== -->

        <section class="section contact-section" id="contact">

            <div class="container">


                <div class="contact-box">


                    <div class="contact-heading">


                        <span>

                            LET'S CONNECT

                        </span>


                        <h2>

                            Have a project

                            <br>

                            in mind?

                        </h2>


                        <p>

                            Feel free to reach out.
                            I'm always interested in discussing
                            new ideas, projects and opportunities.

                        </p>


                    </div>



                    <div class="contact-form-wrapper">


                        <!-- FORM SUBMIT CONTACT FORM -->

                        <form action="https://formsubmit.co/zabihullah91a@gmail.com" method="POST" class="contact-form">


                            <!-- FormSubmit Settings -->

                            <input type="hidden" name="_subject" value="New Portfolio Contact Message">


                            <input type="hidden" name="_template" value="table">


                            <input type="hidden" name="_captcha" value="true">



                            <!-- NAME -->

                            <div class="form-group">


                                <label for="name">

                                    Your Name

                                </label>


                                <input type="text" id="name" name="name" placeholder="Enter your name" required>


                            </div>



                            <!-- EMAIL -->

                            <div class="form-group">


                                <label for="email">

                                    Your Email

                                </label>


                                <input type="email" id="email" name="email" placeholder="Enter your email" required>


                            </div>



                            <!-- SUBJECT -->

                            <div class="form-group">


                                <label for="subject">

                                    Subject

                                </label>


                                <input type="text" id="subject" name="subject" placeholder="Enter subject" required>


                            </div>



                            <!-- MESSAGE -->

                            <div class="form-group">


                                <label for="message">

                                    Message

                                </label>


                                <textarea id="message" name="message" rows="6" placeholder="Write your message..."
                                    required></textarea>


                            </div>



                            <!-- SEND BUTTON -->

                            <button type="submit" class="btn primary-btn contact-submit">


                                <i class="fa-solid fa-paper-plane"></i>

                                Send Message


                            </button>


                        </form>



                        <!-- CONTACT DETAILS -->

                        <div class="contact-details">


                            <a href="mailto:<%= portfolio.personal.email %>" class="contact-item">


                                <span>

                                    EMAIL

                                </span>


                                <strong>

                                    <%= portfolio.personal.email %>

                                </strong>


                            </a>



                            <div class="contact-item">


                                <span>

                                    LOCATION

                                </span>


                                <strong>

                                    <%= portfolio.personal.location %>

                                </strong>


                            </div>


                        </div>


                    </div>

                </div>

            </div>

        </section>


    </main>



    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="footer">


        <div class="container footer-content">


            <div>


                <h3>

                    <%= portfolio.personal.name %>

                </h3>


                <p>

                    B.Tech CSE Student & Aspiring Web Developer

                </p>


            </div>


            <p>

                ©

                <%= new Date().getFullYear() %>

                    <%= portfolio.personal.name %>.

                        All Rights Reserved.

            </p>


        </div>


    </footer>



    <!-- JavaScript -->

    <script src="/js/script.js"></script>


</body>

</html>